# --- Application Configuration ---
APP_NAME=CatalogIQ
ENV=development
PORT=8000

# --- Database Configurations ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogiq
# For Docker Compose, the database service name is used:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/catalogiq

# --- Redis Configuration ---
# Used for Celery background job queue and metadata caching
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# --- Qdrant Configuration ---
# Used for vector database embeddings and semantic search
QDRANT_URL=http://localhost:6333
# For Docker Compose:
# QDRANT_URL=http://qdrant:6333

# --- File Storage Configuration ---
# Options: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage

# S3 Configuration (only used if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=catalogiq-products
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=us-east-1

# --- LLM Provider Configuration ---
# Options: ollama (local dev) | gemini (production) | mock (tests only, requires ENV=test)
LLM_PROVIDER=ollama

# Ollama — Local development (Qwen3 8B recommended)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Controls local Ollama inference timeout (seconds), max HTTP retries, and VRAM keep-alive duration
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m

# Gemini — Production (UniHack MVP)
# Uses google-genai SDK: pip install google-genai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Embedding Model ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Extraction Versioning ---
# WARNING: Changing these values will invalidate the extraction cache for ALL documents.
# Bump EXTRACTION_PROMPT_VERSION when the prompt changes.
# Bump EXTRACTION_SCHEMA_VERSION when ExtractionResult schema changes.
# Bump PIPELINE_VERSION for major pipeline architecture changes.
EXTRACTION_PROMPT_VERSION=v1.0
EXTRACTION_SCHEMA_VERSION=v1
PIPELINE_VERSION=v1

# --- System Thresholds & Limits ---
WORKER_CONCURRENCY=4
MAX_UPLOAD_SIZE_MB=50
# Confidence thresholds (0–100 scale)
# Attributes >= HIGH are marked "verified", >= MEDIUM are "extracted", below are "needs_review"
CONFIDENCE_THRESHOLD_HIGH=85
CONFIDENCE_THRESHOLD_MEDIUM=60
